#!/command/with-contenv bashio
# shellcheck shell=bash
# Bei Absturz des Hauptprozesses den Container beenden, damit der Supervisor neu startet.
# $1 = Exit-Code (256 = durch Signal beendet, $2 = Signalnummer)
if [[ "${1}" -ne 0 && "${1}" -ne 256 ]]; then
  bashio::log.warning "Vaultwarden beendet mit Exit-Code ${1} – Container wird angehalten."
  # Exit-Code an den Container durchreichen, sonst endet er mit 0 (= „sauber gestoppt")
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  /run/s6/basedir/bin/halt
fi
bashio::log.info "Vaultwarden gestoppt."
